FILESEXTRAPATHS:prepend := "${THISDIR}/files:"

# Lockdown (integrity) and signed modules (phone-lockdown.cfg). Modules are
# signed at installation, stripped first (packaging leaves signed modules
# as they are), with the build directory's key: yocto/ota-keys.sh (make
# ota-keys) makes it beside the update keys, never in git. Its checksum is
# in the tasks' signatures, so the shared sstate keeps a kernel and its
# modules per key: with the kernel's autogenerated key it paired one
# build's kernel with another build's modules, and the 6T refused every
# module (39-oneplus-6t.md §8.3). phone-modsig.bbclass checks the image.
SRC_URI += "file://phone-lockdown.cfg"
PHONE_OTA_KEYS ??= "${TOPDIR}/../ota-keys"
PHONE_MODULE_KEY ??= "${PHONE_OTA_KEYS}/kernel-modules.pem"
do_configure[file-checksums] += "${PHONE_MODULE_KEY}:True"
do_configure:append() {
	if [ ! -e "${PHONE_MODULE_KEY}" ]; then
		bbfatal "no kernel module signing key ${PHONE_MODULE_KEY}: yocto/ota-keys.sh makes it (make ota-keys, which make yocto-build runs)"
	fi
	install -D -m 0600 "${PHONE_MODULE_KEY}" ${B}/certs/kario-modules.pem
}
do_install:prepend() {
	export INSTALL_MOD_STRIP=1
}
PHONE_LOCKDOWN_KCONFIG = 'CONFIG_MODULE_SIG=y CONFIG_MODULE_SIG_ALL=y CONFIG_MODULE_SIG_KEY="certs/kario-modules.pem" CONFIG_SECURITY_LOCKDOWN_LSM=y CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y CONFIG_SECURITYFS=y'
python do_phone_lockdown_kconfig() {
    with open(d.getVar('B') + '/.config') as f:
        have = set(f.read().splitlines())
    missing = [c for c in d.getVar('PHONE_LOCKDOWN_KCONFIG').split() if c not in have]
    if missing:
        bb.fatal("the kernel configuration lacks %s (phone-lockdown.cfg)" % " ".join(missing))
}
addtask phone_lockdown_kconfig after do_configure before do_compile

# Sound for phone-audiod: ALSA plus the virtio sound card QEMU provides.
SRC_URI += "file://phone-sound.cfg"

# The camera path of phone-mediad (V4L2); vivid stands in for the sensor.
SRC_URI += "file://phone-camera.cfg"

# System updates: RAUC bundles (squashfs, dm-verity, nbd for streaming).
SRC_URI += "file://phone-ota.cfg"

# Wi-Fi and Bluetooth (iwd, BlueZ); the emulator gets simulated radios.
SRC_URI += "file://phone-radio.cfg"
SRC_URI:append:qemuarm64 = " file://phone-radio-sim.cfg"

# Memory pressure, the notification LED, the backlight (hal); the emulator
# gets a userspace LED in place of the board's.
SRC_URI += "file://phone-power.cfg"
SRC_URI:append:qemuarm64 = " file://phone-power-sim.cfg"

# USB: the phone as a device (file sharing over a USB network link), USB-C,
# keyboards and mice; the emulator gets both ends of the cable.
SRC_URI += "file://phone-usb.cfg"
SRC_URI:append:qemuarm64 = " file://phone-usb-sim.cfg"
# File transfer (MTP) needs FunctionFS and the emulator's USB cases
# dummy_hcd; an option the configuration drops is only a warning in
# do_kernel_configcheck (and the selftest would skip), so it stops here.
PHONE_USB_KCONFIG = "CONFIG_USB_CONFIGFS_F_FS=y"
PHONE_USB_KCONFIG:append:qemuarm64 = " CONFIG_USB_DUMMY_HCD=y"
python do_phone_usb_kconfig() {
    with open(d.getVar('B') + '/.config') as f:
        have = set(f.read().splitlines())
    missing = [c for c in d.getVar('PHONE_USB_KCONFIG').split() if c not in have]
    if missing:
        bb.fatal("the kernel configuration lacks %s (phone-usb.cfg, phone-usb-sim.cfg)" % " ".join(missing))
}
addtask phone_usb_kconfig after do_configure before do_compile

# The VPN: WireGuard and policy routing (phone-vpn.cfg). Without them the
# tunnel would only fail on the device, so a configuration that drops one
# stops here.
SRC_URI += "file://phone-vpn.cfg"
PHONE_VPN_KCONFIG = "CONFIG_WIREGUARD=y CONFIG_IP_MULTIPLE_TABLES=y CONFIG_VETH=y"
python do_phone_vpn_kconfig() {
    with open(d.getVar('B') + '/.config') as f:
        have = set(f.read().splitlines())
    missing = [c for c in d.getVar('PHONE_VPN_KCONFIG').split() if c not in have]
    if missing:
        bb.fatal("the kernel configuration lacks %s (phone-vpn.cfg)" % " ".join(missing))
}
addtask phone_vpn_kconfig after do_configure before do_compile

# No boot messages and no cursor on the screen (phone-console.cfg): fbcon
# takes the display only once text is written to a VT, which only
# console=tty0 does (PHONE_BOOT_LOG). Immediate, it would paint over the
# bootloader's picture before DRM takes over, then a black console.
SRC_URI += "file://phone-console.cfg"
python do_phone_console_kconfig() {
    with open(d.getVar('B') + '/.config') as f:
        have = set(f.read().splitlines())
    if 'CONFIG_FRAMEBUFFER_CONSOLE=y' in have and 'CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y' not in have:
        bb.fatal("the kernel configuration lacks CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y (phone-console.cfg)")
}
addtask phone_console_kconfig after do_configure before do_compile
