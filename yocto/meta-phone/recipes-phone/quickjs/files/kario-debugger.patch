+/* kario-debugger.patch: what a debug handler (JS_SetDebugHandler) reads
+   and writes. */
+
+static JSFunctionBytecode *js_debug_bytecode(JSStackFrame *sf)
+{
+    JSObject *p;
+
+    if (JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return NULL;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (!js_class_has_bytecode(p->class_id))
+        return NULL;
+    return p->u.func.function_bytecode;
+}
+
+/* The instruction a frame is at: the one about to run in a frame the
+   handler was called for, the call in the frames under it. */
+static uint32_t js_debug_pc(JSStackFrame *sf, JSFunctionBytecode *b)
+{
+    if (!sf->cur_pc || sf->cur_pc <= b->byte_code_buf)
+        return 0;
+    return sf->cur_pc - b->byte_code_buf - 1;
+}
+
+static JSStackFrame *js_debug_frame(JSContext *ctx, int level)
+{
+    JSStackFrame *sf;
+
+    if (level < 0)
+        return NULL;
+    for (sf = ctx->rt->current_stack_frame; sf && level > 0; sf = sf->prev_frame)
+        level--;
+    return sf;
+}
+
+static void js_debug_call(JSContext *ctx, JSStackFrame *sf, JSDebugEvent event,
+                          JSValueConst exception, bool caught)
+{
+    JSRuntime *rt = ctx->rt;
+    JSFunctionBytecode *b = js_debug_bytecode(sf);
+    JSDebugPoint at;
+    JSValue exc, bt;
+
+    if (!b || !rt->debug_handler)
+        return;
+    at.frame = sf;
+    at.data = &b->debug_data;
+    at.pc = js_debug_pc(sf, b);
+    at.exception = exception;
+    at.caught = caught;
+    exc = rt->current_exception;
+    bt = ctx->error_back_trace;
+    rt->current_exception = JS_UNINITIALIZED;
+    ctx->error_back_trace = JS_UNDEFINED;
+    rt->debug_handler(ctx, event, &at, rt->debug_opaque);
+    JS_FreeValue(ctx, rt->current_exception);
+    JS_FreeValue(ctx, ctx->error_back_trace);
+    rt->current_exception = exc;
+    ctx->error_back_trace = bt;
+}
+
+static no_inline void js_debug_step(JSContext *ctx, JSStackFrame *sf, uint8_t *pc)
+{
+    ctx->rt->debug_unwinding = false;
+    sf->cur_pc = pc;
+    js_debug_call(ctx, sf, JS_DEBUG_STEP, JS_UNDEFINED, false);
+}
+
+/* Whether pc is inside a try block of b: between an OP_catch and its
+   handler, where the compiler puts the block. */
+static bool js_debug_in_try(JSFunctionBytecode *b, uint32_t pc)
+{
+    uint32_t pos, target;
+    int op;
+
+    for (pos = 0; pos < b->byte_code_len; pos += short_opcode_info(op).size) {
+        op = b->byte_code_buf[pos];
+        if (op == OP_catch) {
+            target = pos + 1 + (int32_t)get_u32(b->byte_code_buf + pos + 1);
+            if (pc > pos && pc < target)
+                return true;
+        }
+    }
+    return false;
+}
+
+/* Whether a frame catches an exception thrown at sf: its own catch offsets
+   on the stack, else the try blocks around the calls in the frames under
+   it, up to an async function's, which rejects its promise instead. */
+static bool js_debug_caught(JSStackFrame *sf, JSValue *sp, JSValue *stack_buf)
+{
+    JSFunctionBytecode *b;
+
+    while (sp > stack_buf) {
+        sp--;
+        if (JS_VALUE_GET_TAG(*sp) == JS_TAG_CATCH_OFFSET && JS_VALUE_GET_INT(*sp) != 0)
+            return true;
+    }
+    for (;;) {
+        b = js_debug_bytecode(sf);
+        if (b && (b->func_kind & JS_FUNC_ASYNC))
+            return false;
+        sf = sf->prev_frame;
+        if (!sf)
+            return false;
+        b = js_debug_bytecode(sf);
+        if (b && sf->cur_pc && js_debug_in_try(b, js_debug_pc(sf, b)))
+            return true;
+    }
+}
+
+int JS_DebugFrameCount(JSContext *ctx)
+{
+    JSStackFrame *sf;
+    int n = 0;
+
+    for (sf = ctx->rt->current_stack_frame; sf; sf = sf->prev_frame)
+        n++;
+    return n;
+}
+
+int JS_DebugFramePoint(JSContext *ctx, int level, JSDebugPoint *at)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSFunctionBytecode *b;
+
+    if (!sf)
+        return -1;
+    b = js_debug_bytecode(sf);
+    at->frame = sf;
+    at->data = b ? &b->debug_data : NULL;
+    at->pc = b ? js_debug_pc(sf, b) : 0;
+    at->exception = JS_UNDEFINED;
+    at->caught = false;
+    return 0;
+}
+
+JSValue JS_DebugFrameInfo(JSContext *ctx, int level)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSFunctionBytecode *b;
+    JSValue ret, name;
+    const char *str;
+    int line, col;
+
+    if (!sf)
+        return JS_UNDEFINED;
+    ret = JS_NewObject(ctx);
+    if (JS_IsException(ret))
+        return ret;
+    b = js_debug_bytecode(sf);
+    str = get_func_name(ctx, sf->cur_func);
+    if (str && *str)
+        name = JS_NewString(ctx, str);
+    else if (b && b->func_name != JS_ATOM_NULL)
+        name = JS_AtomToString(ctx, b->func_name);
+    else
+        name = JS_NewString(ctx, "");
+    JS_FreeCString(ctx, str);
+    JS_DefinePropertyValueStr(ctx, ret, "name", name, JS_PROP_C_W_E);
+    if (!b) {
+        JS_DefinePropertyValueStr(ctx, ret, "native", JS_TRUE, JS_PROP_C_W_E);
+        return ret;
+    }
+    line = find_line_num(ctx, b, js_debug_pc(sf, b), &col);
+    JS_DefinePropertyValueStr(ctx, ret, "file",
+                              b->filename != JS_ATOM_NULL ? JS_AtomToString(ctx, b->filename) : JS_NewString(ctx, ""),
+                              JS_PROP_C_W_E);
+    JS_DefinePropertyValueStr(ctx, ret, "line", js_int32(line), JS_PROP_C_W_E);
+    JS_DefinePropertyValueStr(ctx, ret, "column", js_int32(col), JS_PROP_C_W_E);
+    return ret;
+}
+
+int JS_DebugFrameLines(JSContext *ctx, int level, JSDebugLine **lines)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSFunctionBytecode *b;
+    JSDebugLine *tab, *grown;
+    const uint8_t *p, *p_end;
+    uint32_t pc, val;
+    int32_t v;
+    int n, cap, ret, line, col;
+    unsigned int op;
+
+    *lines = NULL;
+    if (!sf || !(b = js_debug_bytecode(sf)))
+        return -1;
+    cap = 16;
+    tab = js_malloc(ctx, cap * sizeof(*tab));
+    if (!tab)
+        return -1;
+    pc = 0;
+    line = b->line_num;
+    col = b->col_num;
+    n = 0;
+    tab[n++] = (JSDebugLine){ 0, line, col };
+    p = b->pc2line_buf;
+    p_end = p ? p + b->pc2line_len : NULL;
+    while (p && p < p_end) {
+        op = *p++;
+        if (op == 0) {
+            ret = get_leb128(&val, p, p_end);
+            if (ret < 0)
+                break;
+            pc += val;
+            p += ret;
+            ret = get_sleb128(&v, p, p_end);
+            if (ret < 0)
+                break;
+            p += ret;
+            line += v;
+        } else {
+            op -= PC2LINE_OP_FIRST;
+            pc += op / PC2LINE_RANGE;
+            line += (op % PC2LINE_RANGE) + PC2LINE_BASE;
+        }
+        ret = get_sleb128(&v, p, p_end);
+        if (ret < 0)
+            break;
+        p += ret;
+        col += v;
+        if (tab[n - 1].pc == pc) {
+            tab[n - 1] = (JSDebugLine){ pc, line, col };
+            continue;
+        }
+        if (n == cap) {
+            cap *= 2;
+            grown = js_realloc(ctx, tab, cap * sizeof(*tab));
+            if (!grown) {
+                js_free(ctx, tab);
+                return -1;
+            }
+            tab = grown;
+        }
+        tab[n++] = (JSDebugLine){ pc, line, col };
+    }
+    *lines = tab;
+    return n;
+}
+
+static bool js_debug_var(JSStackFrame *sf, JSFunctionBytecode *b, bool closure, int i,
+                         JSAtom *name, JSValue **pv, bool *is_const)
+{
+    JSObject *p = JS_VALUE_GET_OBJ(sf->cur_func);
+
+    if (closure) {
+        if (i < 0 || i >= b->closure_var_count || !p->u.func.var_refs || !p->u.func.var_refs[i])
+            return false;
+        *name = b->closure_var[i].var_name;
+        *is_const = b->closure_var[i].is_const;
+        *pv = p->u.func.var_refs[i]->pvalue;
+        return true;
+    }
+    if (!b->vardefs || i < 0 || i >= b->arg_count + b->var_count)
+        return false;
+    *name = b->vardefs[i].var_name;
+    *is_const = b->vardefs[i].is_const;
+    if (i < b->arg_count) {
+        if (i >= sf->arg_count)
+            return false;
+        *pv = &sf->arg_buf[i];
+    } else {
+        *pv = &sf->var_buf[i - b->arg_count];
+    }
+    return true;
+}
+
+JSValue JS_DebugFrameVariables(JSContext *ctx, int level, bool closure)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSFunctionBytecode *b;
+    JSValue ret, item, *pv;
+    JSAtom name;
+    bool is_const;
+    int i, n;
+    uint32_t k = 0;
+
+    ret = JS_NewArray(ctx);
+    if (JS_IsException(ret) || !sf || !(b = js_debug_bytecode(sf)))
+        return ret;
+    n = closure ? b->closure_var_count : b->arg_count + b->var_count;
+    for (i = 0; i < n; i++) {
+        if (!js_debug_var(sf, b, closure, i, &name, &pv, &is_const) || name == JS_ATOM_NULL)
+            continue;
+        item = JS_NewObject(ctx);
+        if (JS_IsException(item))
+            break;
+        JS_DefinePropertyValueStr(ctx, item, "name", JS_AtomToString(ctx, name), JS_PROP_C_W_E);
+        JS_DefinePropertyValueStr(ctx, item, "index", js_int32(i), JS_PROP_C_W_E);
+        JS_DefinePropertyValueStr(ctx, item, "const", js_bool(is_const), JS_PROP_C_W_E);
+        if (!JS_IsUninitialized(*pv))
+            JS_DefinePropertyValueStr(ctx, item, "value", js_dup(*pv), JS_PROP_C_W_E);
+        JS_DefinePropertyValueUint32(ctx, ret, k++, item, JS_PROP_C_W_E);
+    }
+    return ret;
+}
+
+int JS_DebugSetVariable(JSContext *ctx, int level, bool closure, int index, JSValue val)
+{
+    JSStackFrame *sf = js_debug_frame(ctx, level);
+    JSFunctionBytecode *b;
+    JSValue *pv;
+    JSAtom name;
+    bool is_const;
+
+    if (!sf || !(b = js_debug_bytecode(sf)) || !js_debug_var(sf, b, closure, index, &name, &pv, &is_const) ||
+        is_const || JS_IsUninitialized(*pv)) {
+        JS_FreeValue(ctx, val);
+        return -1;
+    }
+    set_value(ctx, pv, val);
+    return 0;
+}
