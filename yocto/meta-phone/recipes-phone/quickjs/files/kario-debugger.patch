+/* Debugger hooks: Kario's patch (kario-debugger.patch), not upstream
+   QuickJS-ng. A handler sees the bytecode as it runs; the frames on the
+   stack are read and written by level, 0 the innermost. */
+
+typedef enum JSDebugEvent {
+    JS_DEBUG_STEP,      /* before an instruction */
+    JS_DEBUG_STATEMENT, /* a debugger statement */
+    JS_DEBUG_EXCEPTION, /* an exception thrown, before the stack unwinds */
+} JSDebugEvent;
+
+typedef struct JSDebugPoint {
+    /* the frame: the same pointer while it runs */
+    const void *frame;
+    /* the debugger's slot in the frame's function: NULL or memory from
+       js_malloc_rt(), freed with the function; NULL for a native frame */
+    void **data;
+    /* the instruction's offset in its function */
+    uint32_t pc;
+    /* JS_DEBUG_EXCEPTION: the exception, and whether a try around the
+       point in a frame on the stack catches it (an exception that ends an
+       async function rejects its promise: not caught) */
+    JSValueConst exception;
+    bool caught;
+} JSDebugPoint;
+
+typedef void JSDebugHandler(JSContext *ctx, JSDebugEvent event,
+                            const JSDebugPoint *at, void *opaque);
+
+/* Bytecode frames entered while a handler is set call it before each of
+   their instructions; debugger statements and exceptions call it in any
+   frame. The handler may run JavaScript: what it throws is dropped, and
+   the exception being thrown is kept. Code compiled while a handler is set
+   has the position of every statement (otherwise only of calls, property
+   accesses, operators and throws). */
+JS_EXTERN void JS_SetDebugHandler(JSRuntime *rt, JSDebugHandler *handler,
+                                  void *opaque);
+/* Code compiled while on has the position of every statement too, without
+   a handler: a debugger that attaches later stops on every line. */
+JS_EXTERN void JS_SetDebugPositions(JSRuntime *rt, bool on);
+JS_EXTERN int JS_DebugFrameCount(JSContext *ctx);
+/* -1 when there is no such frame. */
+JS_EXTERN int JS_DebugFramePoint(JSContext *ctx, int level, JSDebugPoint *at);
+/* { name, file, line, column }, or { name, native: true } */
+JS_EXTERN JSValue JS_DebugFrameInfo(JSContext *ctx, int level);
+
+typedef struct JSDebugLine {
+    uint32_t pc;
+    int line, column;
+} JSDebugLine;
+
+/* The positions of the level's function, by offset, ascending from 0:
+   their count, *lines from js_malloc(); -1 for a native frame. */
+JS_EXTERN int JS_DebugFrameLines(JSContext *ctx, int level, JSDebugLine **lines);
+/* The level's arguments and locals, or (closure) the outer variables its
+   function uses: an array of { name, index, value, const }, where value
+   is missing for a variable not initialized yet. */
+JS_EXTERN JSValue JS_DebugFrameVariables(JSContext *ctx, int level, bool closure);
+/* Sets the variable index (of JS_DebugFrameVariables) to val (taken). */
+JS_EXTERN int JS_DebugSetVariable(JSContext *ctx, int level, bool closure,
+                                  int index, JSValue val);
+
 /* Version */
 
