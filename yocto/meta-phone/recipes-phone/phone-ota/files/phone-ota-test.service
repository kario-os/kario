[Unit]
Description=System update test step (only with phone.ota-test= on the kernel command line, yocto/qemu-ota.sh)
ConditionKernelCommandLine=phone.ota-test
# Like phone-ota-good: after the system is up, so no default dependencies.
DefaultDependencies=no
After=multi-user.target network-online.target
Wants=network-online.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/phone/ota-test
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
