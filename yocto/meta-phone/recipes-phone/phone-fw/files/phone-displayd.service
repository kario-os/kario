[Unit]
Description=Phone display service (the panel's refresh rate: phone-displayd chooses it, the renderer switches the mode)

[Service]
# Small Go heaps: no transparent huge pages (see phone-shell DisableHugePages).
Environment=GODEBUG=disablethp=1
# The panel's modes come from the DRM card, read once the renderer holds it
# (08-display-adaptive-refresh.md); the emulator's virtio-gpu has one. A
# board whose thermal zones cap the rate adds --thermal-zones here.
ExecStart=/usr/bin/phone-displayd --run-dir /run/phone --panel auto
Restart=on-failure
# The card's modes and the Shell's socket only: no network, nothing
# writable but the run directory.
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/phone
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
