[Unit]
# Socket-activated (phone-keystored.socket): started when the shell first connects.
Requires=phone-keystored.socket
After=phone-keystored.socket
Description=Phone keystore (device and app keys, attestation, confirmed signing)

[Service]
# Small Go heaps: no transparent huge pages (see phone-shell DisableHugePages).
Environment=GODEBUG=disablethp=1
ExecStart=/usr/bin/phone-keystored --run-dir /run/phone --state-dir /var/lib/phone
Restart=on-failure
