[Unit]
Description=Bring-up: keep the phone out of suspend (echo phone-bringup > /sys/power/wake_unlock lets it sleep)
DefaultDependencies=no
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo phone-bringup > /sys/power/wake_lock'
ExecStop=/bin/sh -c 'echo phone-bringup > /sys/power/wake_unlock'

[Install]
WantedBy=multi-user.target
