key f4
at sys.idle
type /
type 鸿雁
key enter
appstate com.phone.chat running
key f4
at sys.idle
type /
type 飞钱
key enter
wait 账单
key f4
appstate com.phone.wallet frozen 8000
appstate com.phone.chat frozen 8000
type /
type 飞钱
key enter
appstate com.phone.wallet running
key enter
wait-re 账单详情|自动刷新
key esc
freeze-after 0

